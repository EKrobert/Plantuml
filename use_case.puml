@startuml Diagramme_Cas_Utilisation_RH

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Employé" as Employe
actor "Responsable Hiérarchique\n(Manager)" as Manager
actor "Responsable RH" as RH

package "Espace Employé" {
  usecase "Consulter ses informations" as UC1
  usecase "Créer une demande de congé" as UC2
  usecase "Suivre l'état de sa demande de congé" as UC3
  usecase "Créer un ordre de mission" as UC4
  usecase "Suivre le statut de son ordre de mission" as UC5
  usecase "Recevoir ses notifications" as UC6
  usecase "Recevoir sa fiche de paie" as UC7
}

package "Espace Manager" {
  usecase "Consulter les employés rattachés" as UC8
  usecase "Consulter les demandes de congé" as UC9
  usecase "Consulter les ordres de mission" as UC10
  usecase "Valider / Refuser une demande de congé" as UC11
  usecase "Valider / Refuser un ordre de mission" as UC12
  usecase "Recevoir les notifications de demandes" as UC13
}

package "Espace RH - Personnel & Congés" {
  usecase "Gérer les employés" as UC14
  usecase "Gérer les départements" as UC15
  usecase "Consulter la hiérarchie" as UC16
  usecase "Gérer les demandes de congé" as UC17
  usecase "Corriger les associations incorrectes" as UC22
}

package "Espace RH - Recrutement, Paie & Mission" {
  usecase "Gérer les candidatures" as UC18
  usecase "Organiser les entretiens" as UC19
  usecase "Générer les contrats" as UC20
  usecase "Traiter et envoyer les fiches de paie" as UC21
  usecase "Gérer les ordres de mission" as UC23
  usecase "Effectuer la validation finale des ordres de mission" as UC24
  usecase "Consulter les informations de suivi RH" as UC25
}

' ---- Relations Employé ----
Employe --> UC1
Employe --> UC2
Employe --> UC3
Employe --> UC4
Employe --> UC5
Employe --> UC6
Employe --> UC7

' ---- Relations Manager ----
Manager --> UC8
Manager --> UC9
Manager --> UC10
Manager --> UC11
Manager --> UC12
Manager --> UC13

' ---- Relations Responsable RH ----
RH --> UC14
RH --> UC15
RH --> UC16
RH --> UC17
RH --> UC18
RH --> UC19
RH --> UC20
RH --> UC21
RH --> UC22
RH --> UC23
RH --> UC24
RH --> UC25

' ---- Dépendances logiques (include) ----
UC2 ..> UC3 : <<include>>
UC4 ..> UC5 : <<include>>
UC9 ..> UC11 : <<include>>
UC10 ..> UC12 : <<include>>

@enduml